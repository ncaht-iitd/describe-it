# Copy to .env in this folder and fill in. Never commit .env.
# Shared secret: the gateway sends it in X-Service-Token. Use a long random string.
SERVICE_TOKEN=
# Provider keys: a model only appears when its provider's key is set
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional
DEFAULT_PROMPT=describe-v1
