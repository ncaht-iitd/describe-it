# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=
# Optional: database name (defaults to image_descriptions)
MONGODB_DB=

# OpenAI (chatbot and description generation)
OPENAI_API_KEY=

# Describe service (services/describe_service). SERVICE_TOKEN must match the service's own setting.
DESCRIBE_SERVICE_URL=http://localhost:8001
SERVICE_TOKEN=
# Optional: generations allowed per visitor per minute (default 6)
GENERATE_PER_MINUTE=

# Appwrite, to check who is signed in (same values as the website's VITE_APPWRITE_* settings)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
