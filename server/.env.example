# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# OpenAI (chatbot and description generation)
OPENAI_API_KEY=

# AWS S3 (library images and tactile PDFs)
AWS_S3_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET_VT=
AWS_S3_BUCKET_VT_TACTILE=
